# RaPaX™ Telegram Bot — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.

# Telegram bot token — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=replace_with_bot_token_from_botfather

# RaPaX™ server this bot talks to
RAPAX_API_URL=http://localhost:4000/api

# Operator secret — matches RaPaX server's OPERATOR_SECRET, used for /operator commands
RAPAX_OPERATOR_SECRET=replace_with_operator_secret

# Poll interval (ms) for checking pending purchase/delivery status
POLL_INTERVAL_MS=15000

# Telegram chat ID(s) allowed to run operator commands (comma-separated numeric IDs)
OPERATOR_CHAT_IDS=replace_with_your_telegram_numeric_id
